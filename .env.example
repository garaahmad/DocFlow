# Local defaults. Replace the auth secret before starting.
DATABASE_URL=postgresql://docflow:docflow_local@127.0.0.1:5433/docflow
REDIS_URL=redis://127.0.0.1:6380
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=docflow-local
S3_ACCESS_KEY_ID=docflow-local
S3_SECRET_ACCESS_KEY=docflow-local-object-storage
S3_PATH_STYLE=true

GEMINI_EXTRACTION_API_KEY=
GEMINI_VALIDATION_API_KEY=
GEMINI_INSIGHTS_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_VALIDATION_MODEL=gemini-3.1-flash-lite
GEMINI_INSIGHTS_MODEL=gemini-3.1-flash-lite
GEMINI_VALIDATE_ALL=false
GEMINI_EXTRACTION_INPUT_USD_PER_MILLION=
GEMINI_EXTRACTION_OUTPUT_USD_PER_MILLION=
GEMINI_VALIDATION_INPUT_USD_PER_MILLION=
GEMINI_VALIDATION_OUTPUT_USD_PER_MILLION=
GEMINI_INSIGHTS_INPUT_USD_PER_MILLION=
GEMINI_INSIGHTS_OUTPUT_USD_PER_MILLION=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
PLATFORM_ADMIN_EMAILS=
